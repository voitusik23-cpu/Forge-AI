FORGE_ENV=development
FORGE_DEBUG=true
FORGE_DEFAULT_PROVIDER=mock
FORGE_DEFAULT_MODEL=mock
FORGE_REQUEST_TIMEOUT=30
FORGE_RETRY_COUNT=2
FORGE_LOG_LEVEL=INFO

# Local API keys. Put real values only in the ignored .env file.
